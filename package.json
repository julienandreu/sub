  "description": "Saris AI Desktop App",
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.32.0",
    "@preact/preset-vite": "^2.10.0",
    "@swc/core": "1.13.5",
    "@types/node": "^24.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20250715.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
